# =========================
# NoteSync Project .gitignore
# This file tells Git which files/folders to ignore
# Purpose: Keep secrets, reduce repo size, avoid unnecessary files
# =========================

# Node modules – dependencies, don't push
node_modules/

# Environment variables – contains secrets like JWT keys and DB URLs
.env

# Build folders – generated by React or backend
build/
dist/

# VS Code settings – personal editor configs
.vscode/

# OS files – system-generated
.DS_Store
Thumbs.db